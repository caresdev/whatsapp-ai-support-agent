# ===========================================
# WhatsApp Business Cloud API
# ===========================================
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_app_secret_for_signature_verification

# ===========================================
# Host & TLS  (read by infra/docker-compose.yml)
# ===========================================
# n8n is served at https://${SUBDOMAIN}.${DOMAIN_NAME}
DOMAIN_NAME=your-domain.com
SUBDOMAIN=n8n
# Where Let's Encrypt sends expiry warnings.
SSL_EMAIL=you@your-domain.com
# Timezone for cron/schedule nodes, e.g. America/Sao_Paulo.
GENERIC_TIMEZONE=UTC

# ===========================================
# Google Sheets (Service Account)
# ===========================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# ===========================================
# AI Model
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
# Or if using Anthropic or any other model:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Note: If using any other model provider other than OpenAI, n8n nodes must be adjusted to 
# match that choice.

# ===========================================
# Qdrant Vector Store (Phase 4)
# ===========================================
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION=pastelaria_knowledge

# ===========================================
# Owner Notification
# ===========================================
OWNER_WHATSAPP_NUMBER=5511999999999